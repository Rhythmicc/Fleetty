[Unit]
Description=Fleetty node terminal (user)

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=FLEETTY_INSTALL_SCOPE=user
Environment=SSH_HOST=0.0.0.0
Environment=SSH_PORT=23234
Environment=SSH_HOST_KEY_PATH=%h/.config/fleetty/ssh_host_ed25519
Environment=SSH_AUTHORIZED_KEYS_FILE=%h/.config/fleetty/authorized_keys
Environment=SSH_MAX_CONNECTIONS=64
Environment=SSH_IDLE_TIMEOUT=30m
Environment=SSH_MAX_TIMEOUT=24h
Environment=DEFAULT_THEME=dark
EnvironmentFile=-%h/.config/fleetty/machine.env
EnvironmentFile=-%h/.config/fleetty/admin.env
ExecStart=%h/.local/bin/fleetty
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=default.target
