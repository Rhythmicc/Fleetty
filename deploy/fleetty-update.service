[Unit]
Description=Fleetty subordinate node release rollout
Documentation=https://github.com/Rhythmicc/fleetty
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/fleetty/fleet-update.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/fleetty/fleettyctl update --file /etc/fleetty/fleet-update.json --yes
CacheDirectory=fleetty
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/cache/fleetty
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
