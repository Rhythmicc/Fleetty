[Unit]
Description=Go-native read-only machine SSH terminal monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gpu-ssh-monitor
Environment=HOME=/root
Environment=SSH_HOST=0.0.0.0
Environment=SSH_PORT=23234
Environment=SSH_HOST_KEY_PATH=/etc/gpu-ssh-monitor/ssh_host_ed25519
Environment=SSH_AUTHORIZED_KEYS_FILE=/etc/gpu-ssh-monitor/authorized_keys
# Nodes connected to a Hub should set NODE_RPC_AUTHORIZED_KEYS_FILE in machine.env.
Environment=SSH_MAX_CONNECTIONS=64
Environment=SSH_IDLE_TIMEOUT=30m
Environment=SSH_MAX_TIMEOUT=24h
Environment=DEFAULT_THEME=dark
# Optional machine profile (for example, a NAS), owned by root (0600).
EnvironmentFile=-/etc/gpu-ssh-monitor/machine.env
# Optional management-password and command overrides, owned by root (0600).
EnvironmentFile=-/etc/gpu-ssh-monitor/admin.env
ExecStart=/opt/gpu-ssh-monitor/gpu-ssh-monitor
Restart=always
RestartSec=2
UMask=0077
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/etc/gpu-ssh-monitor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
