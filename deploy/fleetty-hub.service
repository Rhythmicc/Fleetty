[Unit]
Description=Fleetty Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fleetty
Environment=HOME=/root
Environment=FLEETTY_INSTALL_SCOPE=system
Environment=SSH_HOST=0.0.0.0
Environment=SSH_PORT=23235
Environment=SSH_HOST_KEY_PATH=/etc/fleetty/hub_host_ed25519
Environment=SSH_AUTHORIZED_KEYS_FILE=/etc/fleetty/authorized_keys
Environment=SSH_MAX_CONNECTIONS=64
Environment=SSH_IDLE_TIMEOUT=30m
Environment=SSH_MAX_TIMEOUT=24h
Environment=DEFAULT_THEME=dark
Environment=HUB_NODES_FILE=/etc/fleetty/nodes.json
ExecStart=/opt/fleetty/fleetty
Restart=always
RestartSec=2
UMask=0077
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/etc/fleetty
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
